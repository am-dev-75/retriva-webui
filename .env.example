# Retriva WebUI Configuration
# Copy this file to .env to override defaults

# The base URL for the Retriva Gateway API
VITE_RETRIVA_GATEWAY_BASE_URL=http://localhost:8002

# Application Name
VITE_APP_NAME=Retriva

# Feature Flags
VITE_ENABLE_AUTH=false
VITE_ENABLE_ARTIFACTS=true
VITE_ENABLE_FOLDER_UPLOAD=true
VITE_ENABLE_SPEECH_INPUT=false
VITE_SPEECH_INPUT_MODE=disabled
